# Kopieren nach .env und Passwörter ersetzen:
#   cp .env.example .env
#   sed -i "s/CHANGEME_ROOT/$(openssl rand -base64 24)/" .env
#   sed -i "s/CHANGEME_APP/$(openssl rand -base64 24)/"  .env

DB_NAME=lager
DB_USER=lager_app
DB_PASS=CHANGEME_APP
DB_ROOT_PASS=CHANGEME_ROOT

WEB_PORT=8080
ADMINER_PORT=8081
